{
  "name": "@punluesunnah/content-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Islamic content (hadith, dua, khutbah, tazkiyah, akhlaq, books, ustaz) backed by Postgres.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx seed/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@punluesunnah/shared-types": "*",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
