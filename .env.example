# Copy to .env — docker compose and every `npm run dev` process read this file.

# ── postgres (content-service) ────────────────────────────────────────────
POSTGRES_USER=punluesunnah
POSTGRES_PASSWORD=punluesunnah
POSTGRES_DB=punluesunnah
# Host port compose publishes Postgres on (change if 5432 is taken locally).
POSTGRES_PORT=5432
# Local dev talks to the compose-exposed port; inside compose it is overridden
# to the `postgres` hostname.
DATABASE_URL=postgres://punluesunnah:punluesunnah@localhost:5432/punluesunnah

# Shared secret the admin app's Server Actions send on write requests.
CONTENT_API_KEY=change-me-dev-key

# ── quran-service ─────────────────────────────────────────────────────────
# https://api-docs.quran.foundation — client-credentials app
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# ── apps/web + apps/admin → services (server-side only; never exposed to the browser) ──
CONTENT_SERVICE_URL=http://localhost:4001
QURAN_SERVICE_URL=http://localhost:4002
PRAYER_SERVICE_URL=http://localhost:4003

# ── apps/admin → apps/web cache revalidation ─────────────────────────────
# After a save the admin app expires the web app's cached content via
# POST $WEB_URL/api/revalidate, authenticated with this shared secret.
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret
