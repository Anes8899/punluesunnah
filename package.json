{
  "name": "punluesunnah-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,admin,content,quran,prayer -c cyan,blue,green,yellow,magenta \"npm:dev:web\" \"npm:dev:admin\" \"npm:dev:content\" \"npm:dev:quran\" \"npm:dev:prayer\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:content": "npm run dev -w services/content-service",
    "dev:quran": "npm run dev -w services/quran-service",
    "dev:prayer": "npm run dev -w services/prayer-service",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:push": "npm run db:push -w services/content-service",
    "db:seed": "npm run db:seed -w services/content-service"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
